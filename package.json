{
  "name": "thejudge",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev:mock",
    "dev:mock": "ASK_AI_PROVIDER=mock node scripts/dev.mjs",
    "dev:openai": "ASK_AI_PROVIDER=openai node scripts/dev.mjs",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "dev:backend": "npm --workspace apps/backend run dev",
    "typecheck": "npm --workspace apps/frontend run typecheck && npm --workspace apps/backend run typecheck",
    "test": "npm --workspace apps/frontend run test && npm --workspace apps/backend run test && npm run test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs scripts/lib/*.test.mjs",
    "coverage:check": "npm --workspace apps/frontend run test:coverage && npm --workspace apps/backend run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"**/*.{json,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{json,yml,yaml}\" --check",
    "quality:check": "npm run typecheck && npm run lint && npm run format:check && npm run coverage:check && npm run test:scripts",
    "build": "npm --workspace apps/frontend run build && npm --workspace apps/backend run build",
    "data:build": "node scripts/build-card-metadata.mjs && node scripts/build-card-detail-by-oracle-id.mjs && node scripts/build-card-rulings.mjs && node scripts/build-game-rules.mjs && node scripts/build-card-prices.mjs && node scripts/build-commander-spellbook-combos.mjs",
    "data:refresh": "node scripts/refresh-scryfall-data.mjs",
    "data:refresh-combos": "node scripts/refresh-commander-spellbook-data.mjs",
    "openai:verify-credentials": "node scripts/openai-verify-credentials.mjs",
    "prompt:preview": "node scripts/prompt-preview.mjs",
    "prompt:preview:all": "node scripts/prompt-preview.mjs --all-fixtures",
    "retrieval:report": "tsx scripts/retrieval-relevance-report.mjs",
    "combo:answer-quality": "tsx scripts/compare-combo-answer-quality.mjs",
    "eval:worked-solutions": "tsx scripts/eval-worked-solutions.mjs",
    "data:scan-vectors": "tsx scripts/build-scan-vectors.mjs",
    "data:scan-fingerprints": "tsx scripts/build-card-hashes.mjs",
    "data:scan-fingerprints:fresh": "tsx scripts/build-card-hashes.mjs --fresh",
    "data:scan-hashes": "npm run data:scan-fingerprints",
    "data:scan-map": "tsx scripts/build-card-scan-map.mjs",
    "skills:ai-sync": "node scripts/sync-agent-skills.mjs",
    "graph:preflight": "node scripts/graph-preflight.mjs",
    "graph:digest": "node scripts/graph-digest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "tsx": "^4.19.1",
    "typescript-eslint": "^8.59.3",
    "yaml": "2.9.0"
  }
}
