# [ARCHIVED] AWS provider template retained for rollback only.
# Active template: secrets-templates/openai-dev.env.example
#
# Copy to repository root: .secrets/aws-bedrock-dev.env
# mkdir -p .secrets && cp secrets-templates/aws-bedrock-dev.env.example .secrets/aws-bedrock-dev.env
# Edit the copy only; never commit files under .secrets/ (see PRD/instructions/secrets-handling.md).
