# Prefer AWS named profiles (AWS_PROFILE in apps/backend/.env) and ~/.aws/credentials.
# Use this file only for temporary session keys if you cannot use a profile.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
