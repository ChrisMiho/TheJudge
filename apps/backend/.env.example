PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DEBUG_LOGGING=true
LOG_PAYLOADS=true
# Provider mode: "mock" (default) or "bedrock"
ASK_AI_PROVIDER=mock
# Required when ASK_AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# Optional Bedrock runtime controls when ASK_AI_PROVIDER=bedrock
BEDROCK_TIMEOUT_MS=15000
BEDROCK_MAX_ATTEMPTS=2
# Optional profile override for local profile/SSO auth flow
AWS_PROFILE=default
# After filling profile/region/model, from repo root run: npm run aws:verify
#
# Never put access keys or session tokens in this file. Use ~/.aws/credentials (profile)
# or copy secrets-templates/aws-bedrock-dev.env.example to .secrets/aws-bedrock-dev.env
# (see PRD/instructions/secrets-handling.md).
