PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DEBUG_LOGGING=true
LOG_PAYLOADS=true
# Provider mode: "mock" (default) or "openai"
ASK_AI_PROVIDER=mock
# Required when ASK_AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI runtime controls when ASK_AI_PROVIDER=openai
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2
# Keep OPENAI_API_KEY in .secrets/openai-dev.env only.
# After filling model + key, from repo root run: npm run openai:verify-credentials
#
# Never put real API keys in this file.
# Copy secrets-templates/openai-dev.env.example to .secrets/openai-dev.env
# (see PRD/instructions/secrets-handling.md).
