VITE_API_URL=http://localhost:3000
VITE_DEBUG_LOGGING=true
# Formspree form id used by the in-app "Send feedback" modal.
# Public, non-secret build-time config (it ships in the client bundle) — never put a
# recipient email or any secret here; the recipient is registered with Formspree itself.
# Leave empty to keep feedback delivery unconfigured: submission is a graceful no-op.
VITE_FEEDBACK_FORMSPREE_ID=
