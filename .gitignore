# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local git worktrees
.worktrees/

# Superpowers skill runtime state (brainstorm preview server pid/log files)
.superpowers/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example
.secrets/

# Dependencies/build
node_modules/
# The trailing-slash pattern above matches directories only. A `node_modules`
# *symlink* is not a directory, so it stayed untracked and `git stash push -u`
# swept it into a stash, breaking the toolchain. This bare pattern covers the
# symlink/file case without narrowing the directory ignore.
node_modules
dist/
build/
.next/
coverage/
*.tsbuildinfo
.tmp/

# Local bulk datasets (do not commit)
apps/frontend/data/scryfall/default-cards.json
apps/frontend/data/scryfall/default-cards.json.tmp
# Raw card-scan image inputs / download cache (build inputs only; the hashed
# output ships under apps/frontend/public/data/). Keep card_back_reference.png
# locally here to enable _card_back fingerprinting — it is intentionally ignored.
apps/frontend/data/scryfall/card-images/
apps/backend/data/cr/source.txt
apps/backend/data/cr/source.txt.tmp
apps/backend/data/scryfall/rulings.json
apps/backend/data/scryfall/rulings.json.tmp
# Commander Spellbook raw refresh pages (build inputs only; the trimmed corpus
# ships as apps/backend/data/commanderSpellbookCombo*.json)
apps/backend/data/commander-spellbook/
apps/backend/data/commander-spellbook.tmp/

# Prompt preview output (developer-local; not committed)
output/prompt-preview/

# Retrieval relevance report (developer-local; not committed)
output/retrieval-relevance-report.txt

# Combo answer-quality comparison output (developer-local; only the reviewed
# conclusion becomes durable history)
output/combo-answer-quality/

# Card-scan fingerprint build logs / pid (transient; the bin ships under public/data/)
output/cardhash-build/

# Playwright MCP output (console logs, page snapshots, screenshots)
.playwright-mcp/

# Ad-hoc debugging screenshots dropped in repo root (should live under .tmp/ instead)
/*.png
/*.jpg
/*.jpeg

.vitest-reports/
apps/backend/data/models/
